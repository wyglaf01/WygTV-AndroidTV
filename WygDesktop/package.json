{
  "name": "wygdesktop",
  "productName": "WygDesktop",
  "version": "1.0.0",
  "description": "WygDesktop - IPTV player for Windows and Ubuntu (desktop copy of WygTV)",
  "author": "Eddie <wyglaf01@users.noreply.github.com>",
  "homepage": "https://github.com/wyglaf01/WygTV-AndroidTV",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "5.2.0",
    "hls.js": "1.5.20",
    "mpegts.js": "1.8.0"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.wygtv.desktop",
    "productName": "WygDesktop",
    "copyright": "WygTV",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/hls.js/src/**",
      "!node_modules/mpegts.js/src/**",
      "!node_modules/mpegts.js/d.ts/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "WygDesktop-Setup.${ext}",
      "shortcutName": "WygDesktop",
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "WygDesktop-Portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "synopsis": "IPTV player: live TV, guide, movies, series and antenna TV",
      "artifactName": "WygDesktop-linux.${ext}",
      "desktop": {
        "Name": "WygDesktop",
        "Comment": "Live TV, movies, series and antenna TV"
      },
      "extraResources": [
        {
          "from": "vendor/ffmpeg-linux",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg"
          ]
        }
      ]
    },
    "deb": {
      "maintainer": "Eddie <wyglaf01@users.noreply.github.com>",
      "afterInstall": "linux/after-install.sh",
      "afterRemove": "linux/after-remove.sh",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "ffmpeg"
      ]
    },
    "publish": null,
    "afterPack": "linux/after-pack.js"
  }
}
